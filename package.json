{
  "name": "ssaft-viewer",
  "productName": "SSAF-T Viewer",
  "version": "0.1.11",
  "description": "The SSAF-T cell-type map viewer, for an SSAF-T store (.zarr) on your own computer",
  "author": "PNU CoLab",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "sync": "sh scripts/sync-viewer.sh",
    "build:server": "python scripts/build_server.py",
    "dist": "python scripts/build_server.py && electron-builder",
    "dist:dir": "python scripts/build_server.py && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.pnucolab.ssaft-viewer",
    "productName": "SSAF-T Viewer",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**",
      "build-resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/server/ssaft-server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "build-resources/icon-mac.png",
      "hardenedRuntime": true,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Science",
      "icon": "build-resources/icon.png"
    },
    "artifactName": "SSAF-T-Viewer-${os}-${arch}.${ext}",
    "dmg": {
      "title": "SSAF-T Viewer ${version}",
      "icon": "build-resources/icon-mac.png",
      "background": "build-resources/background.png",
      "window": {
        "width": 540,
        "height": 260
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 118,
          "type": "file"
        },
        {
          "x": 400,
          "y": 118,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "repository": "github:khyeonm/SSAF-T_viewer"
}
