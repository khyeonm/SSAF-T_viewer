{
  "name": "ssaft-viewer",
  "productName": "SSAF-T Viewer",
  "version": "0.1.0",
  "description": "The SSAF-T cell-type map viewer, for an SSAF-T store (.zarr) on your own computer",
  "author": "PNU CoLab",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "sync": "sh scripts/sync-viewer.sh",
    "build:server": "python scripts/build_server.py",
    "dist": "python scripts/build_server.py && electron-builder",
    "dist:dir": "python scripts/build_server.py && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.pnucolab.ssaft-viewer",
    "productName": "SSAF-T Viewer",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**",
      "build-resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/server/ssaft-server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Science"
    },
    "artifactName": "SSAF-T-Viewer-${version}-${os}-${arch}.${ext}",
    "dmg": {
      "title": "SSAF-T Viewer ${version}"
    }
  },
  "repository": "github:khyeonm/SSAF-T_viewer"
}
